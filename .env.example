# 이 파일을 복사해서 .env 파일을 만들고 값을 채운다: cp .env.example .env
# .env 는 Git에 올라가지 않는다. 키를 코드나 AI 대화에 붙여 넣지 않는다.

OPENAI_API_KEY=

# 화면 접근 비밀번호 (비워 두면 개발 모드로 비밀번호 없이 열린다)
APP_PASSWORD=

# 기본값을 바꾸고 싶을 때만 채운다
# ANSWER_MODEL_NAME=gpt-5-mini
# EMBEDDING_MODEL_NAME=text-embedding-3-small

# 3단계 리랭커 (GPU가 있는 VM에서만 켠다. 로컬 Mac은 질문당 약 13초라 끈다)
# 켜기 전에 선택 패키지 설치: uv sync --extra rerank
# USE_RERANKER=true
# 3단계 BM25 키워드 검색 (리랭커와 같이 켤 때만 쓴다. 패키지는 위와 같은 uv sync --extra rerank)
# USE_BM25=true

# 시나리오 A (Ollama)
# ANSWER_MODEL_PROVIDER=ollama
# OLLAMA_MODEL_NAME=
# OLLAMA_BASE_URL=http://localhost:11434
